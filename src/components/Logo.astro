---
interface Props { size?: number; bg?: string; fg?: string; mid?: string }
const { size = 28, bg = '#714B67', fg = '#FFFFFF', mid = '#F6D46B' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 26 26" aria-hidden="true"><rect width="26" height="26" rx="5" fill={bg}></rect><rect x="6" y="7" width="14" height="2" fill={fg}></rect><rect x="6" y="12" width="10" height="2" fill={mid}></rect><rect x="6" y="17" width="14" height="2" fill={fg}></rect></svg>
