---
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-800.css';
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pagina niet gevonden · Ledgerwerk</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    :root { --ink:#1E1A1D; --paper:#F7F5F2; --accent:#714B67; --muted:#5E555B; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--paper); color:var(--ink); font-family:'Schibsted Grotesk', system-ui, sans-serif; padding:24px; box-sizing:border-box; }
    main { max-width:560px; display:flex; flex-direction:column; gap:18px; }
    .code { font-size:14px; letter-spacing:.12em; color:var(--accent); font-weight:800; }
    h1 { margin:0; font-size:clamp(36px,6vw,56px); line-height:1; letter-spacing:-.04em; font-weight:800; }
    p { margin:0; font-size:17px; line-height:1.55; color:var(--muted); }
    nav { display:flex; flex-wrap:wrap; gap:10px; margin-top:8px; }
    a { display:inline-block; padding:12px 20px; border-radius:999px; background:var(--accent); color:#fff; text-decoration:none; font-weight:800; font-size:15px; }
    a.alt { background:transparent; color:var(--ink); border:1px solid #DDD5DA; }
  </style>
</head>
<body>
  <main>
    <span class="code">404</span>
    <h1>Deze pagina bestaat niet.</h1>
    <p>This page does not exist. · Esta página no existe.</p>
    <nav>
      <a href="/nl/">Naar de homepage</a>
      <a class="alt" href="/en/">English</a>
      <a class="alt" href="/es/">Español</a>
    </nav>
  </main>
</body>
</html>
